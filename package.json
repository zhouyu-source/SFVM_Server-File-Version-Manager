{
  "name": "sfvm",
  "version": "1.0.0",
  "description": "服务器文件版本管理工具 (Server File Version Manager)",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:gpu-off": "cross-env SFVM_DISABLE_GPU=1 electron-vite dev",
    "dev:nosandbox": "cross-env SFVM_NO_SANDBOX=1 SFVM_DISABLE_GPU=1 electron-vite dev",
    "build": "electron-vite build",
    "setup:electron": "node node_modules/electron/install.js",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:it": "node scripts/with-it-env.mjs vitest run tests/integration",
    "test:e2e": "node scripts/with-it-env.mjs --set SFVM_E2E=1 vitest run --no-file-parallelism tests/e2e",
    "test:smoke": "node scripts/with-it-env.mjs --set SFVM_SMOKE=1 --set SFVM_E2E=1 vitest run --no-file-parallelism tests/e2e/b16-packaged-smoke.e2e.test.ts",
    "build:win": "npm run build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win",
    "build:dir": "npm run build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --dir --win",
    "db:generate": "drizzle-kit generate",
    "format": "prettier --write .",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@element-plus/icons-vue": "2.3.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.38.4",
    "electron-log": "^5.4.4",
    "ssh2": "^1.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "2.1.9",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.30.6",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "element-plus": "^2.9.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "pinia": "^2.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "unplugin-auto-import": "^0.19.0",
    "unplugin-vue-components": "^0.28.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.0"
  }
}
